cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/NativeAuthProviders.cmake")

# Deliberately keep an Apple host while testing non-Apple targets. The target
# controls the providers, including when a reused cache asks for the opposite.
set(CMAKE_HOST_SYSTEM_NAME Darwin)
set(cases "Darwin|ON" "iOS|ON" "Android|OFF" "Windows|OFF" "Linux|OFF" "tvOS|OFF")
set(checks 0)
foreach(case IN LISTS cases)
    string(REPLACE "|" ";" parts "${case}")
    list(GET parts 0 CMAKE_SYSTEM_NAME)
    list(GET parts 1 expected)
    foreach(stale IN ITEMS ON OFF)
        set(MTCONTROLS_APPLE_SIGN_IN_ENABLED "${stale}" CACHE BOOL "stale cache fixture" FORCE)
        set(MTCONTROLS_APPLE_SIGN_IN_ENABLED "${stale}")
        mtcontrols_configure_native_auth_providers()
        if(NOT MTCONTROLS_APPLE_SIGN_IN_ENABLED STREQUAL expected)
            message(FATAL_ERROR "${CMAKE_SYSTEM_NAME}: provider policy is ${MTCONTROLS_APPLE_SIGN_IN_ENABLED}, expected ${expected}")
        endif()
        get_property(cached CACHE MTCONTROLS_APPLE_SIGN_IN_ENABLED PROPERTY VALUE)
        if(NOT cached STREQUAL expected)
            message(FATAL_ERROR "${CMAKE_SYSTEM_NAME}: stale cache was not normalized")
        endif()
        math(EXPR checks "${checks} + 1")
    endforeach()
endforeach()
message(STATUS "Native auth provider policy: ${checks} target/cache cases passed")
